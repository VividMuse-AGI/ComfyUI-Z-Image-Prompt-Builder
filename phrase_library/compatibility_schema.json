{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Z-Image Cross-library Compatibility Rules",
  "type":"object",
  "required":["schema_version","language","target_models","validation","source_libraries","precedence","runtime_policy","composition_rules","override_groups","structural_rules","visibility_rules","compatibility_rules","portrait_recipes"],
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z0-9_]+$"},
    "fieldId":{"type":"string","pattern":"^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
    "idArray":{"type":"array","items":{"$ref":"#/$defs/id"},"minItems":1,"uniqueItems":true},
    "fieldArray":{"type":"array","items":{"$ref":"#/$defs/fieldId"},"uniqueItems":true},
    "valueMap":{"type":"object","additionalProperties":{"$ref":"#/$defs/idArray"}},
    "bundleMap":{"type":"object","additionalProperties":{"$ref":"#/$defs/idArray"}},
    "when":{
      "type":"object",
      "properties":{
        "field":{"$ref":"#/$defs/fieldId"},
        "values":{"$ref":"#/$defs/idArray"},
        "bundle_group":{"$ref":"#/$defs/id"},
        "bundle_values":{"$ref":"#/$defs/idArray"}
      },
      "additionalProperties":false,
      "anyOf":[{"required":["field","values"]},{"required":["bundle_group"]}]
    }
  },
  "properties":{
    "schema_version":{"type":"string"},
    "language":{"const":"zh-CN"},
    "target_models":{"type":"array","items":{"enum":["Z-Image","Z-Image-Turbo"]},"minItems":1,"uniqueItems":true},
    "validation":{
      "type":"object",
      "required":["reference_rules","logic_tests","model_image_tests"],
      "properties":{
        "reference_rules":{"enum":["pending","passed"]},
        "logic_tests":{"enum":["pending","passed"]},
        "model_image_tests":{"enum":["pending","partial","passed"]}
      },
      "additionalProperties":false
    },
    "source_libraries":{"type":"array","items":{"type":"string","pattern":"^[a-z0-9_]+\\.json$"},"minItems":1,"uniqueItems":true},
    "precedence":{"type":"array","items":{"$ref":"#/$defs/id"},"minItems":5,"uniqueItems":true},
    "runtime_policy":{
      "type":"object",
      "required":["adult_safety","control_only_fields","default_nonempty_fields","intentional_empty","user_lock_conflict","preference_merge","empty_intersection","bundle_partial_lock","visibility_omit","density_trim","determinism"],
      "properties":{
        "adult_safety":{"const":"reject_unsafe_autofill_and_locked_values"},
        "control_only_fields":{"$ref":"#/$defs/fieldArray"},
        "default_nonempty_fields":{"$ref":"#/$defs/fieldArray"},
        "intentional_empty":{"const":"allow_explicit_not_used_and_all_empty"},
        "user_lock_conflict":{"const":"preserve_user_values_and_skip_conflicting_autofill"},
        "preference_merge":{"const":"weighted_intersection_then_highest_weight"},
        "empty_intersection":{"const":"fall_back_to_selected_recipe_pool"},
        "bundle_partial_lock":{"const":"filter_compatible_bundles_before_random_choice"},
        "visibility_omit":{"const":"omit_only_auto_generated_fields"},
        "density_trim":{"const":"trim_only_auto_generated_optional_fields"},
        "determinism":{"const":"all_random_choices_use_node_seed"}
      },
      "additionalProperties":false
    },
    "composition_rules":{
      "type":"array","minItems":1,
      "items":{
        "type":"object",
        "required":["id","label","input_fields","value_source","templates","policy"],
        "properties":{
          "id":{"$ref":"#/$defs/id"},
          "label":{"type":"string","minLength":1},
          "input_fields":{"$ref":"#/$defs/fieldArray","minItems":2},
          "value_source":{"const":"fragment"},
          "templates":{
            "type":"object",
            "required":["both","first_only","second_only"],
            "properties":{
              "both":{"type":"string","minLength":1},
              "first_only":{"type":"string","minLength":1},
              "second_only":{"type":"string","minLength":1}
            },
            "additionalProperties":false
          },
          "policy":{"type":"string","minLength":1}
        },
        "additionalProperties":false
      }
    },
    "override_groups":{
      "type":"array","minItems":1,
      "items":{"type":"object","required":["id","label","trigger_fields","policy"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"type":"string","minLength":1},"trigger_fields":{"$ref":"#/$defs/fieldArray"},"clear_fields":{"$ref":"#/$defs/fieldArray"},"clear_values":{"$ref":"#/$defs/valueMap"},"policy":{"type":"string","minLength":1}},"additionalProperties":false,"anyOf":[{"required":["clear_fields"]},{"required":["clear_values"]}]}
    },
    "structural_rules":{
      "type":"array","minItems":1,
      "items":{"type":"object","required":["id","label","when","policy"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"type":"string","minLength":1},"when":{"$ref":"#/$defs/when"},"require_fields":{"$ref":"#/$defs/fieldArray"},"require_any_fields":{"type":"array","items":{"$ref":"#/$defs/fieldArray"},"minItems":1},"clear_fields":{"$ref":"#/$defs/fieldArray"},"lock_together":{"$ref":"#/$defs/fieldArray"},"policy":{"type":"string","minLength":1}},"additionalProperties":false}
    },
    "visibility_rules":{
      "type":"array","minItems":1,
      "items":{"type":"object","required":["id","label","shot_sizes","priority_fields","omit_fields","max_optional_details"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"type":"string","minLength":1},"shot_sizes":{"$ref":"#/$defs/idArray"},"priority_fields":{"$ref":"#/$defs/fieldArray"},"omit_fields":{"$ref":"#/$defs/fieldArray"},"max_optional_details":{"type":"integer","minimum":1,"maximum":30}},"additionalProperties":false}
    },
    "compatibility_rules":{
      "type":"array","minItems":1,
      "items":{"type":"object","required":["id","label","when","weight"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"type":"string","minLength":1},"when":{"$ref":"#/$defs/when"},"prefer_bundles":{"$ref":"#/$defs/bundleMap"},"exclude_fields":{"$ref":"#/$defs/fieldArray"},"allow_values":{"$ref":"#/$defs/valueMap"},"require_fields":{"$ref":"#/$defs/fieldArray"},"require_any_fields":{"type":"array","items":{"$ref":"#/$defs/fieldArray"},"minItems":1},"weight":{"type":"integer","minimum":1,"maximum":5}},"additionalProperties":false}
    },
    "portrait_recipes":{
      "type":"array","minItems":1,
      "items":{"type":"object","required":["id","label","tags","bundles","field_pool"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"type":"string","minLength":1},"tags":{"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},"bundles":{"type":"object","minProperties":6,"additionalProperties":{"$ref":"#/$defs/id"}},"field_pool":{"$ref":"#/$defs/valueMap"}},"additionalProperties":false}
    }
  },
  "additionalProperties":false
}
